#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install --yes wireguard iptables

# Remove the previous configuration's firewall rules before replacing it.
if systemctl is-active --quiet wg-quick@wg0; then
  systemctl stop wg-quick@wg0
fi

install -d -m 0700 /etc/wireguard
if [[ ! -f /etc/wireguard/server.key ]]; then
  umask 077
  wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub
fi

server_private_key="$(cat /etc/wireguard/server.key)"

cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${server_address}
ListenPort = ${listen_port}
PrivateKey = $server_private_key
PostUp = iptables -t nat -A POSTROUTING -s ${client_cidr} ! -d 172.16.1.0/24 -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -s ${client_cidr} ! -d 172.16.1.0/24 -j MASQUERADE

${peer_blocks}
EOF

chmod 0600 /etc/wireguard/wg0.conf /etc/wireguard/server.key
chmod 0644 /etc/wireguard/server.pub

cat > /etc/sysctl.d/99-wireguard-forwarding.conf <<EOF
net.ipv4.ip_forward=1
EOF
sysctl --system

systemctl enable wg-quick@wg0
systemctl restart wg-quick@wg0
